      "description": "Convert the ESA L2A products to Cloud-Optimized GeoTIFFs and serve them in the public sentinel-cogs bucket that every asset href in this table points at.",
      "roles": [
        "processor"
      ],
      "url": "https://registry.opendata.aws/sentinel-2-l2a-cogs/"
    },
    {
      "name": "Element 84 (Earth Search)",
      "description": "Runs the Earth Search STAC API whose sentinel-2-l2a items this table mirrors.",
      "roles": [
        "processor"
      ],
      "url": "https://earth-search.aws.element84.com/v1"
    },
    {
      "name": "Portolan Mirrors",
      "description": "Republishes the Earth Search item index as partitioned STAC-GeoParquet.",
      "roles": [
        "processor",
        "host"
      ],
      "url": "https://github.com/portolan-mirrors/sentinel-2-catalog"
    }
  ],
