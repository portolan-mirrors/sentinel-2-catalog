  "partition:keys": [
    {
      "name": "year",
      "type": "int32",
      "description": "Year of acquisition (UTC). Every year is one items.parquet, in uniform row groups of about 6,000 rows, so a tile's run is a small number of groups and a tile lookup reads only those. Any year may add live.parquet, the tail fetched daily since the last fold, which the periodic fold merges back into the year file. There is no zone= directory and no zone split: every part sits in year=YYYY/ and matches partition:glob."
    }
